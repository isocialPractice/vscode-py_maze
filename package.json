{
  "name": "vscode-py_maze",
  "displayName": "VS Code Maze",
  "description": "A maze game generator and player for VS Code",
  "version": "0.0.0-dev",
  "author": "John Haugabook",
  "publisher": "isocialPractice",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-py_maze.generateMaze",
        "title": "Maze: Generate New Maze"
      },
      {
        "command": "vscode-py_maze.playMaze",
        "title": "Maze: Play Maze Game"
      }
    ],
    "configuration": {
      "title": "VS Code Maze",
      "properties": {
        "vscode-py_maze.width": {
          "type": "number",
          "default": 9,
          "minimum": 3,
          "maximum": 25,
          "description": "Width of the maze in cells"
        },
        "vscode-py_maze.height": {
          "type": "number",
          "default": 11,
          "minimum": 3,
          "maximum": 25,
          "description": "Height of the maze in cells"
        },
        "vscode-py_maze.localWeather": {
          "type": "boolean",
          "default": false,
          "description": "Style the maze from local weather and refresh every 60 seconds. When turned off, the maze keeps the style it last rendered."
        },
        "vscode-py_maze.weatherLatitude": {
          "type": "number",
          "default": 40.7128,
          "minimum": -90,
          "maximum": 90,
          "description": "Latitude used for the local weather lookup"
        },
        "vscode-py_maze.weatherLongitude": {
          "type": "number",
          "default": -74.006,
          "minimum": -180,
          "maximum": 180,
          "description": "Longitude used for the local weather lookup"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  }
}
